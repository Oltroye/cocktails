extends layout

block content
  .form-container
    h2 Login
    form(action="/log_in", method="POST")
      .form-group
        label(for="email") Email:
        input(type="email", name="email", required)
      .form-group
        label(for="password") Password:
        input(type="password", name="password", required)
      button(type="submit") Login
