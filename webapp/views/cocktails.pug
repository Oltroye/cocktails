extends layout

block content
  .cocktail-grid
    each cocktail in cocktailList
      .cocktail-card
        .card-header
          img.cocktail-image(src=cocktail.picture, alt=cocktail.name)
          h2 #{cocktail.name}

        p #{cocktail.description}

        if cocktail.alcoolFree
          p Sans alcool
        else
          p Avec alcool

        p Difficulté: #{cocktail.difficulty}
        p Popularité: #{cocktail.popularity}

        if cocktail.makable
          p Vous pouvez le faire
        else
          p Vous ne pouvez pas le faire

        p Preparation Time: #{cocktail.preparationTime}
        p Glass Type: #{cocktail.glassType}
        p Recipe: #{cocktail.recipe}

        if cocktail.chose
          p Already in the card
          form(action="/cocktails/" + id + "/remove/" + cocktail.idCocktail, method="POST") 
            button(type="submit") Retirer
        else 
          form(action="/cocktails/" + id + "/add/" + cocktail.idCocktail, method="POST")
            button(type="submit") Ajouter
