extends layout

block content
    for ingridient in ingridients
        p #{ingridient.name}
        p #{ingridient.nameType}
        if ingridient.isOwned
            p Owned
            form(action="/stock/"+id+"/unowned/"+ingridient.idIngredients, method="POST") 
                button(type="submit") set unowned
        else 
            p Unowned
            form(action="/stock/"+id+"/owned/"+ingridient.idIngredients, method="POST")
                button(type="submit") set owned