extends layout

block content
  .ingredient-list
    each ingridient in ingridients
      .ingredient-card
        h2= ingridient.name
        p Type: #{ingridient.nameType}

        if ingridient.isOwned
          p Actuellement : Possédé
          form(action=`/stock/${id}/unowned/${ingridient.idIngredients}`, method="POST")
            button.button-link(type="submit") Retirer du stock
        else
          p Actuellement : Non possédé
          form(action=`/stock/${id}/owned/${ingridient.idIngredients}`, method="POST")
            button.button-link(type="submit") Ajouter au stock
            
        form(action="/stock/"+id+"/del/"+ingridient.idIngredients, method="POST") 
          button(type="submit") Suprimer