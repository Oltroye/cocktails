extends layout

block content
  .ingredient-list
    for ingridient in ingridients
      .ingredient-card
        p Nom: #{ingridient.name}
        p Type: #{ingridient.nameType}
        if ingridient.isOwned
          p Statut: Owned
          form(action="/stock/"+id+"/unowned/"+ingridient.idIngredients, method="POST") 
            button(type="submit") Non Posséder
        else 
          p Statut: Unowned
          form(action="/stock/"+id+"/owned/"+ingridient.idIngredients, method="POST")
            button(type="submit") Posséder
