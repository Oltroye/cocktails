doctype html
html
  head
    title= title
    link(rel='stylesheet', href='/stylesheets/style.css')
  body
    header
      a(href="/")
        img.logo(src="/stylesheets/logo.png", alt="Logo")
      .buttons
        if conected
          button: a(href="/cocktails/" + id) Cocktails
          button: a(href="/stock/" + id) Stock
        else
          button: a(href="/sign_up") Inscription
          button: a(href="/log_in") Connexion
    block content
